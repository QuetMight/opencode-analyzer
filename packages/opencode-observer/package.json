{
  "name": "@opencode-analyzer/observer",
  "version": "0.1.0",
  "description": "OpenCode Observer - Logger and Session Logger plugin",
  "author": "QuetMight",
  "license": "MIT",
  "type": "module",
  "main": "dist/opencode-observer.js",
  "types": "dist/opencode-observer.d.ts",
  "exports": {
    ".": "./dist/opencode-observer.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "opencode",
    "logging",
    "logger",
    "session-logger",
    "opencode-plugin"
  ],
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "bun run build:bundle --minify",
    "build:dev": "bun run build:bundle",
    "build:bundle": "bun build ./src/index.ts --outfile dist/opencode-observer.js --target node --format esm",
    "dev": "bun run build:dev --watch",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/opencode-analyzer/opencode-observer"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.3.5",
    "@opencode-ai/sdk": "^1.3.5",
    "@types/node": "^20.10.0",
    "@types/bun": "^1.3.14",
    "typescript": "^5.3.0"
  }
}